#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.Товары");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = Товары;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	ЭлементБлокировки.УстановитьЗначение("Склад", Склад);
	Блокировка.Заблокировать();
	
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не заполнен склад";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	// Контроль достаточности остатков товаров на складе.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТоварыОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыОстатки.КоличествоОстаток КАК Остаток
		|ИЗ
		|	РегистрНакопления.Товары.Остатки(&Период, Склад = &Склад) КАК ТоварыОстатки";
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Склад", Склад);
	ОстаткиПоНоменклатуре = Запрос.Выполнить().Выгрузить();
	ОстаткиПоНоменклатуре.Индексы.Добавить("Номенклатура");
	
	ТребуемоеКоличество = Новый Соответствие;
	Для Каждого СтрокаТовары Из Товары Цикл
		ВсегоТребуется = ТребуемоеКоличество.Получить(СтрокаТовары.Номенклатура);
		Если ВсегоТребуется = Неопределено Тогда
			ВсегоТребуется = 0;
		КонецЕсли;
		ТребуемоеКоличество.Вставить(СтрокаТовары.Номенклатура, ВсегоТребуется + СтрокаТовары.Количество);
	КонецЦикла;
	
	Для Каждого ПараНоменклатураКоличество Из ТребуемоеКоличество Цикл
		СтрокаОстатка = ОстаткиПоНоменклатуре.Найти(ПараНоменклатураКоличество.Ключ, "Номенклатура");
		Остаток = ?(СтрокаОстатка = Неопределено, 0, СтрокаОстатка.Остаток);
		Если ПараНоменклатураКоличество.Значение > Остаток Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(
				"Недостаточно товара ""%1"" на складе ""%2"": остаток %3, требуется %4",
				Строка(ПараНоменклатураКоличество.Ключ), Строка(Склад), Остаток, ПараНоменклатураКоличество.Значение);
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Движения.Товары.Записывать = Истина;
	Для Каждого СтрокаТовары Из Товары Цикл
		Движение = Движения.Товары.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = СтрокаТовары.Номенклатура;
		Движение.Склад = Склад;
		Движение.Количество = СтрокаТовары.Количество;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
